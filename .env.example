# Outention Personal — copy this file to .env.local.
OUTENTION_MODE=personal
HOST=127.0.0.1
PORT=4173
PUBLIC_BASE_URL=http://127.0.0.1:4173
BASE_PATH=
TRUST_PROXY=0
# Generated automatically when the first source is saved. Do not share it.
LOCAL_DATA_KEY=
# Optional override; defaults beside .env.local.
OUTENTION_CONNECTIONS_PATH=

# Choose one: openai, anthropic, gemini, or openrouter.
# You may leave these empty and save the key from Settings after startup.
MODEL_PROVIDER=openrouter
MODEL_API_KEY=
MODEL_NAME=openai/gpt-5.6-luna
# Local OpenAI-compatible example:
# MODEL_PROVIDER=local
# MODEL_NAME=gemma4:e4b
# MODEL_BASE_URL=http://127.0.0.1:11434/v1

# Optional safety and usage limits for a local installation.
BETA_ACCESS_CODE=
REQUIRE_BLUESKY_APP_PASSWORD=0
ACCESS_ATTEMPTS_PER_15_MIN=10
API_REQUESTS_PER_10_MIN=180
FEED_BUILDS_PER_HOUR=30
FEED_BUILDS_PER_DAY=100

# Optional Reddit application credentials. Reddit may require approval.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://127.0.0.1:4173/api/oauth/reddit/callback
REDDIT_USER_AGENT=web:com.outention.personal:v0.1 (by /u/YOUR_REDDIT_USERNAME)

# Optional Threads application credentials. Enables OAuth public keyword discovery;
# the Threads API does not expose the user's Following/Home feed.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://127.0.0.1:4173/api/oauth/threads/callback

# Public sources.
LOCATIONEWS_URL=https://locationews.com
MASTODON_DISCOVERY_INSTANCE=https://mastodon.social
